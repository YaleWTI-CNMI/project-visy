[sub_resource type="GDScript" id="GDScript_lmske"]
script/source = "extends Node3D

@onready var mesh_inst = $MeshInstance3D

func update_data(data):
	var obj_data = data.result.data
	var model_mesh: Mesh = ObjParse.load_obj_from_buffer(obj_data, {})
	mesh_inst.mesh = model_mesh
	
	if \"caption\" in data.result:
		$Label3D.text = data.result.caption
	else:
		$Label3D.text = \"\"
	
	if \"color\" in data.result:
		var r = float(data.result.color.r)
		var g = float(data.result.color.g)
		var b = float(data.result.color.b)
		mesh_inst.material_override.albedo_color = Color(r, g, b).srgb_to_linear()
	
	fit_mesh_instance_to_size(mesh_inst, 0.3)
	$Label3D.position = $Label3D.position - Vector3(0, 0.2, 0)
	
func fit_mesh_instance_to_size(mesh_instance: MeshInstance3D, absolute_size: float) -> void:
	var mesh := mesh_instance.mesh
	if mesh == null:
		push_error(\"MeshInstance3D has no mesh assigned.\")
		return

	var aabb: AABB = mesh.get_aabb()
	var center: Vector3 = aabb.position + aabb.size / 2.0
	var max_dim: float = max(aabb.size.x, aabb.size.y, aabb.size.z)
	if max_dim == 0.0:
		push_error(\"Mesh has zero size in all dimensions.\")
		return

	var scale_factor: float = absolute_size / max_dim
	
	var transform := Transform3D.IDENTITY
	transform.origin = -center * scale_factor
	transform.basis *= scale_factor

	mesh_instance.transform = transform
"


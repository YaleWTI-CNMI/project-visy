[sub_resource type="GDScript" id="GDScript_00mdf"]
script/source = "extends Node3D

func _process(delta: float) -> void:
	var shader_mat = $MeshInstance3D.get_active_material(0) as ShaderMaterial
	shader_mat.set_shader_parameter(\"low_clamp\", %LowGrip.position)
	shader_mat.set_shader_parameter(\"high_clamp\", %HighGrip.position)
"


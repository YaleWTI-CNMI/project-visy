code = "// NOTE: Shader automatically converted from Godot Engine 4.4.stable's StandardMaterial3D.

shader_type spatial;
render_mode cull_back, unshaded, blend_add;


uniform sampler2D texture_emission : source_color, hint_default_black, filter_linear_mipmap, repeat_enable;
uniform vec4 emission : source_color;
uniform float emission_energy : hint_range(0.0, 100.0, 0.01);


void vertex() {
}

void fragment() {
	vec2 base_uv = UV;
	
	vec3 emission_tex = texture(texture_emission, base_uv).rgb;
	// Emission Operator: Add
	ALBEDO = (emission.rgb * emission_tex.r * emission_tex.g * emission_tex.b) * emission_energy;
}
"


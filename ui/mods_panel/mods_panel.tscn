[gd_scene load_steps=3 format=3 uid="uid://dpexdaave61u7"]

[ext_resource type="Theme" uid="uid://dqjl0oqkkyb1o" path="res://ui/themes/default_theme.tres" id="1_wwqjg"]

[sub_resource type="GDScript" id="GDScript_rufe7"]
resource_name = "ModsPanel"
script/source = "extends Panel

func _ready():
	WSClient.plot_added.connect(_on_plot_added)
	WSClient.disconnected.connect(_on_client_disconnected)
	pass
	
func _process(delta: float):
	pass
	
func _on_client_disconnected(code):
	for child in %ModMatrix.get_children():
		child.queue_free()

func _on_plot_added(data):
	for mod_name in data.mods.keys():
		var mod_label = Label.new()
		%ModMatrix.add_child(mod_label)
		
		mod_label.text = \"%s (%s) -- %s\" % [data.result.type, data.id, mod_name]
		
		var mod_info = data.mods[mod_name]
		match mod_info.definition.type:
			\"continuous\":
				var mod_slider = HSlider.new()
				%ModMatrix.add_child(mod_slider)
				
				mod_slider.size_flags_horizontal = Control.SIZE_EXPAND_FILL
				var m = mod_info.definition.range[0]
				var M = mod_info.definition.range[1]
				var step = mod_info.definition.step
				
				
				mod_slider.min_value = m
				mod_slider.max_value = M
				mod_slider.step = step
				mod_slider.tick_count = floor((M - m) / step)
				mod_slider.value_changed.connect(func(newval):
					WSClient.queue_message({
						type = \"UPDATE_MODS\",
						data = {
							id = int(data.id),
							mods = {
								mod_name: newval
							}
						}
					})
					)
"


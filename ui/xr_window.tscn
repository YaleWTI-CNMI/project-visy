[sub_resource type="GDScript" id="GDScript_k4wdk"]
script/source = "extends InteractionReceiver

var last_pointer_pos: Vector2
var pointer_pos: Vector2 = Vector2.ZERO

var _icontroller: InteractionController = null

func acquire(icontroller: InteractionController):
	_icontroller = icontroller
	_icontroller.controller.button_pressed.connect(_on_button_pressed)
	_icontroller.controller.button_released.connect(_on_button_released)
	pass

func hit(icontroller: InteractionController, interaction_point: Vector3):
	var pos_2d = project_point_to_plane_uv(interaction_point, owner.transform)
	pos_2d.x = pos_2d.x / (owner.plane_size.x / 2)
	pos_2d.y = pos_2d.y / (owner.plane_size.y / 2)
	
	pos_2d = (pos_2d + Vector2(1.0, 1.0)) / 2
	
	pos_2d = Vector2(pos_2d.x * owner.size_2d.x, owner.size_2d.y - pos_2d.y * owner.size_2d.y)

	last_pointer_pos = pointer_pos
	pointer_pos = pos_2d
	%Cursor.global_position = pos_2d - %Cursor.size / 2

	push_mouse_move()
	pass

func release(icontroller: InteractionController):
	_icontroller.controller.button_pressed.disconnect(_on_button_pressed)
	_icontroller.controller.button_released.disconnect(_on_button_released)
	_icontroller = null
	pass

func _on_button_pressed(name):
	if name == \"trigger_click\":
		var event = InputEventMouseButton.new()
		event.button_index = 1
		event.pressed = true
		event.position = pointer_pos
		event.global_position = pointer_pos
		event.button_mask = 1
		%SubViewport.push_input(event)

func _on_button_released(name):
	if name == \"trigger_click\":
		var event = InputEventMouseButton.new()
		event.button_index = 1
		event.pressed = false
		event.position = pointer_pos
		event.global_position = pointer_pos
		event.button_mask = 0
		%SubViewport.push_input(event)

func _process(delta: float) -> void:
	push_mouse_move()
	
func push_mouse_move() -> void:
	var event = InputEventMouseMotion.new()
	event.position = pointer_pos
	event.global_position = pointer_pos
	event.relative = pointer_pos - last_pointer_pos
	#event.button_mask = 1 if pressed else 0
	#event.pressure = 1.0 if pressed else 0.0
	%SubViewport.push_input(event)

func project_point_to_plane_uv(point: Vector3, plane_transform: Transform3D) -> Vector2:
	# Convert the world point into the plane's local space
	var local_point: Vector3 = plane_transform.affine_inverse() * point

	# Return the X and Z or X and Y components depending on your plane's orientation.
	# If your plane is flat (like a floor), you'd use X and Z
	# But if your plane's \"surface\" is defined by its XY plane, we use X and Y
	return Vector2(local_point.x, local_point.y)
"

